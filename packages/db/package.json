{
  "name": "@avclub/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@avclub/types": "workspace:*",
    "drizzle-orm": "^0.33.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.24.2",
    "typescript": "^5.5.4",
    "tsup": "^8.2.4"
  }
}
